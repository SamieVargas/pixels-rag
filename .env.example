# Copy this file to .env and fill in your values. .env is git-ignored.

# The deployed Life in Pixels Apps Script web app URL
PIXELS_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# The token your Apps Script expects for the rag_export action
PIXELS_TOKEN=your-generated-token-here

# Anthropic API key (used for answer generation)
ANTHROPIC_API_KEY=sk-ant-your-key-here
